generator client {
  provider = "prisma-client-js"
}

// MongoDB (for example MongoDB Atlas). DATABASE_URL must include the database name,
// e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/universal-air-cooler
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String   @default("Admin")
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String    @default("")
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String    @unique
  categoryId       String?   @db.ObjectId
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription String    @default("")
  description      String    @default("")
  features         String    @default("") // one per line
  specs            String    @default("") // "Label: Value" per line, "|"-lines for a model table
  price            Float?
  showPrice        Boolean   @default(false)
  images           String    @default("[]") // JSON array of image URLs
  featured         Boolean   @default(false)
  active           Boolean   @default(true)
  metaTitle        String    @default("")
  metaDescription  String    @default("")
  enquiries        Enquiry[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  title     String   @default("")
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String   @default("")
  city      String   @default("")
  subject   String   @default("")
  message   String
  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id @map("_id")
  value String
}

// Uploaded images are stored in the database, so the site needs no writable disk (works on Vercel).
// Served at /uploads/<path>.
model Upload {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  path        String   @unique // e.g. "products/1700000000-ab12cd.jpg"
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// Downloadable PDF catalogues. The PDF is stored in pieces (CatalogueChunk, max ~3.5 MB each)
// so files of any size can be uploaded and downloaded within Vercel's 4.5 MB request limit.
// Served at /catalogues/<slug>.pdf.
model Catalogue {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String           @unique
  description String           @default("")
  fileName    String
  size        Int
  chunkCount  Int
  coverUrl    String           @default("")
  sortOrder   Int              @default(0)
  visible     Boolean          @default(true)
  ready       Boolean          @default(false) // true once every chunk has been uploaded
  downloads   Int              @default(0)
  chunks      CatalogueChunk[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CatalogueChunk {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  catalogueId String    @db.ObjectId
  catalogue   Catalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  index       Int
  data        Bytes

  @@unique([catalogueId, index])
}
