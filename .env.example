# Copy this file to .env and fill in real values. Never put real passwords in this file: it is committed to Git.

# MongoDB connection string, including the database name (here "universal-air-cooler")
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/universal-air-cooler?retryWrites=true&w=majority"

# Long random string used to sign admin logins
JWT_SECRET="replace-with-a-long-random-string"

# Optional: the live address. On Vercel it defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL="https://www.universalaircooler.in"

# Used only by `npm run setup` to create the first admin account (minimum 8 characters)
ADMIN_EMAIL="admin@universalaircooler.com"
ADMIN_PASSWORD="choose-a-strong-password"
